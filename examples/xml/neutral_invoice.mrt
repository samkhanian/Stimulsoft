<?xml version="1.0" encoding="utf-8"?>
<!-- 
  نمونه MRT خنثی (Neutral) برای معماری هیبریدی
  توضیح: این فایل صرفاً Layout را تعریف می‌کند
  تمام رنگ‌ها، فونت‌ها و Branding در Runtime اعمال می‌شود
-->
<Report Name="neutral_invoice" ReportUnit="Millimeters">
  <Dictionary/>
  <ReportPage Name="Page1" Orientation="Portrait" Width="210" Height="297">
    <!-- سربرگ صفحه - در Runtime با لوگو و شرکت نام پر می‌شود -->
    <PageHeaderBand Name="PageHeader" Height="60">
      <TextObject Name="CompanyNamePlaceholder" Left="10" Top="10" Width="190" Height="15">
        <Text>{{COMPANY_NAME}}</Text>
      </TextObject>
      <PictureObject Name="LogoPlaceholder" Left="10" Top="25" Width="40" Height="35">
        <!-- لوگو در Runtime جاگزین می‌شود -->
      </PictureObject>
      <TextObject Name="ReportTitlePlaceholder" Left="55" Top="25" Width="135" Height="15">
        <Text>صورتحساب</Text>
      </TextObject>
    </PageHeaderBand>

    <!-- نوار اطلاعات فاکتور -->
    <ReportTitleBand Name="InvoiceInfoBand" Height="40">
      <TextObject Name="InvoiceNumberLabel" Left="10" Top="5" Width="40" Height="10">
        <Text>شماره فاکتور:</Text>
      </TextObject>
      <TextObject Name="InvoiceNumberValue" Left="55" Top="5" Width="60" Height="10">
        <Text>[InvoiceNumber]</Text>
      </TextObject>

      <TextObject Name="InvoiceDateLabel" Left="10" Top="18" Width="40" Height="10">
        <Text>تاریخ:</Text>
      </TextObject>
      <TextObject Name="InvoiceDateValue" Left="55" Top="18" Width="60" Height="10">
        <Text>[InvoiceDate]</Text>
      </TextObject>

      <TextObject Name="DueDateLabel" Left="130" Top="5" Width="40" Height="10">
        <Text>سررسید:</Text>
      </TextObject>
      <TextObject Name="DueDateValue" Left="175" Top="5" Width="25" Height="10">
        <Text>[DueDate]</Text>
      </TextObject>
    </ReportTitleBand>

    <!-- نوار اطلاعات مشتری و تامین‌کننده -->
    <ReportTitleBand Name="CustomerInfoBand" Height="50">
      <TextObject Name="BillToLabel" Left="10" Top="5" Width="30" Height="8">
        <Text>صورتحساب برای:</Text>
      </TextObject>
      <TextObject Name="CustomerName" Left="10" Top="15" Width="85" Height="12">
        <Text>[CustomerName]</Text>
      </TextObject>
      <TextObject Name="CustomerAddress" Left="10" Top="28" Width="85" Height="20">
        <Text>[CustomerAddress]</Text>
      </TextObject>

      <TextObject Name="ShipToLabel" Left="115" Top="5" Width="30" Height="8">
        <Text>ارسال به:</Text>
      </TextObject>
      <TextObject Name="ShipToAddress" Left="115" Top="15" Width="85" Height="33">
        <Text>[ShipAddress]</Text>
      </TextObject>
    </ReportTitleBand>

    <!-- جدول آیتم‌های فاکتور -->
    <DataBand Name="ItemsDataBand" DataSource="InvoiceItems" Height="15">
      <!-- سطر هدر جدول -->
      <TableObject Name="ItemsTable" Left="10" Top="0" Width="190" Height="15">
        <TableColumn Name="ItemColumn" Width="60"/>
        <TableColumn Name="QuantityColumn" Width="35"/>
        <TableColumn Name="UnitPriceColumn" Width="40"/>
        <TableColumn Name="AmountColumn" Width="55"/>
        
        <!-- ردیف هدر -->
        <TableRow Name="HeaderRow" Height="8">
          <TableCell Name="ItemHeader" ColumnIndex="0">
            <TextObject Name="ItemHeaderText" Text="شرح کالا" />
          </TableCell>
          <TableCell Name="QuantityHeader" ColumnIndex="1">
            <TextObject Name="QuantityHeaderText" Text="تعداد" />
          </TableCell>
          <TableCell Name="UnitPriceHeader" ColumnIndex="2">
            <TextObject Name="UnitPriceHeaderText" Text="قیمت واحد" />
          </TableCell>
          <TableCell Name="AmountHeader" ColumnIndex="3">
            <TextObject Name="AmountHeaderText" Text="مبلغ" />
          </TableCell>
        </TableRow>

        <!-- ردیف داده‌ها -->
        <TableRow Name="DataRow" Height="7">
          <TableCell Name="ItemCell" ColumnIndex="0">
            <TextObject Name="ItemText">
              <Text>[ItemDescription]</Text>
            </TextObject>
          </TableCell>
          <TableCell Name="QuantityCell" ColumnIndex="1">
            <TextObject Name="QuantityText">
              <Text>[Quantity]</Text>
            </TextObject>
          </TableCell>
          <TableCell Name="UnitPriceCell" ColumnIndex="2">
            <TextObject Name="UnitPriceText">
              <Text>[UnitPrice]</Text>
            </TextObject>
          </TableCell>
          <TableCell Name="AmountCell" ColumnIndex="3">
            <TextObject Name="AmountText">
              <Text>[Amount]</Text>
            </TextObject>
          </TableCell>
        </TableRow>
      </TableObject>
    </DataBand>

    <!-- خط جداکننده -->
    <ReportTitleBand Name="SeparatorBand" Height="3">
      <LineObject Name="Separator" Left="10" Top="1" Width="190" Height="0"/>
    </ReportTitleBand>

    <!-- خلاصه مبالغ -->
    <ReportTitleBand Name="SummaryBand" Height="45">
      <TextObject Name="SubtotalLabel" Left="120" Top="5" Width="50" Height="8">
        <Text>جمع کل:</Text>
      </TextObject>
      <TextObject Name="SubtotalValue" Left="175" Top="5" Width="25" Height="8">
        <Text>[Subtotal]</Text>
      </TextObject>

      <TextObject Name="TaxLabel" Left="120" Top="15" Width="50" Height="8">
        <Text>مالیات (۹٪):</Text>
      </TextObject>
      <TextObject Name="TaxValue" Left="175" Top="15" Width="25" Height="8">
        <Text>[Tax]</Text>
      </TextObject>

      <TextObject Name="TotalLabel" Left="120" Top="30" Width="50" Height="10">
        <Text>مجموع:</Text>
      </TextObject>
      <TextObject Name="TotalValue" Left="175" Top="30" Width="25" Height="10">
        <Text>[Total]</Text>
      </TextObject>
    </ReportTitleBand>

    <!-- پاده‌نوشت -->
    <PageFooterBand Name="PageFooter" Height="30">
      <TextObject Name="ThankYouText" Left="10" Top="5" Width="190" Height="15">
        <Text>با سپاس از خریدتان</Text>
      </TextObject>
      <TextObject Name="PageNumberText" Left="10" Top="20" Width="190" Height="8">
        <Text>صفحه [PageNumber] از [TotalPages]</Text>
      </TextObject>
    </PageFooterBand>
  </ReportPage>
</Report>

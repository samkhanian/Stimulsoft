{
  "themeName": "Corporate-Blue-v2.0",
  "themeVersion": "2.0",
  "description": "تم شرکتی آبی برای تمام گزارش‌ها",
  "createdDate": "2025-05-22",
  "lastModified": "2025-05-22",
  
  "colors": {
    "primary": "#007ACC",
    "primaryDark": "#004E7C",
    "secondary": "#F3F3F3",
    "accent": "#FF5722",
    "success": "#4CAF50",
    "warning": "#FFC107",
    "error": "#F44336",
    "text": {
      "primary": "#212121",
      "secondary": "#757575",
      "disabled": "#BDBDBD",
      "light": "#FFFFFF"
    },
    "background": {
      "primary": "#FFFFFF",
      "secondary": "#F5F5F5",
      "tertiary": "#EEEEEE"
    },
    "borders": {
      "light": "#E0E0E0",
      "medium": "#BDBDBD",
      "dark": "#757575"
    }
  },

  "fonts": {
    "family": {
      "primary": "Segoe UI, Tahoma, sans-serif",
      "mono": "Courier New, monospace"
    },
    "sizes": {
      "small": 9,
      "body": 11,
      "subtitle": 13,
      "heading3": 14,
      "heading2": 16,
      "heading1": 18,
      "title": 24
    },
    "weights": {
      "light": 300,
      "normal": 400,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.8
    }
  },

  "branding": {
    "logoUrl": "/assets/logos/company-logo.png",
    "logoSmallUrl": "/assets/logos/company-logo-small.png",
    "companyName": "شرکت نمونه",
    "companyEnglishName": "Sample Company",
    "companyRegistration": "۱۲۳۴۵۶۷۸۹۰",
    "companyTaxId": "۱۲۳۴۵۶۷۸",
    "website": "www.example.com",
    "email": "info@example.com",
    "phone": "+98-21-1234-5678",
    "address": "تهران، خیابان کوثر، پلاک ۱۲"
  },

  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },

  "borders": {
    "radiusSmall": 2,
    "radiusMedium": 4,
    "radiusLarge": 8
  },

  "typography": {
    "heading1": {
      "size": 24,
      "weight": "bold",
      "color": "#007ACC",
      "marginBottom": 16
    },
    "heading2": {
      "size": 18,
      "weight": "semibold",
      "color": "#004E7C",
      "marginBottom": 12
    },
    "heading3": {
      "size": 14,
      "weight": "semibold",
      "color": "#004E7C",
      "marginBottom": 10
    },
    "body": {
      "size": 11,
      "weight": "normal",
      "color": "#212121",
      "lineHeight": 1.5
    },
    "caption": {
      "size": 9,
      "weight": "normal",
      "color": "#757575"
    }
  },

  "tables": {
    "headerBackground": "#007ACC",
    "headerTextColor": "#FFFFFF",
    "headerFontWeight": "bold",
    "rowAlternateBackground": "#F5F5F5",
    "rowBorderColor": "#E0E0E0",
    "cellPadding": 8,
    "cellBorderWidth": 1,
    "footerBackground": "#F3F3F3",
    "footerFontWeight": "semibold"
  },

  "headers": {
    "pageHeaderHeight": 60,
    "pageHeaderBackground": "#F5F5F5",
    "pageHeaderBorder": {
      "width": 1,
      "color": "#E0E0E0",
      "position": "bottom"
    }
  },

  "footers": {
    "pageFooterHeight": 30,
    "pageFooterBackground": "#F5F5F5",
    "pageFooterBorder": {
      "width": 1,
      "color": "#E0E0E0",
      "position": "top"
    },
    "pageNumberFormat": "صفحه [PageNumber] از [TotalPages]"
  },

  "pageSetup": {
    "orientation": "portrait",
    "paperSize": "A4",
    "margins": {
      "top": 20,
      "right": 20,
      "bottom": 20,
      "left": 20
    }
  },

  "rtl": {
    "enabled": true,
    "textAlign": "right"
  },

  "numberFormat": {
    "currency": {
      "symbol": "تومان",
      "position": "suffix",
      "decimalPlaces": 0,
      "thousandsSeparator": ","
    },
    "percentage": {
      "decimalPlaces": 2,
      "symbol": "٪"
    },
    "date": "yyyy/MM/dd",
    "time": "HH:mm:ss"
  },

  "components": {
    "button": {
      "backgroundColor": "#007ACC",
      "textColor": "#FFFFFF",
      "paddingX": 16,
      "paddingY": 8,
      "borderRadius": 4,
      "fontSize": 11,
      "fontWeight": "normal"
    },
    "badge": {
      "backgroundColor": "#F3F3F3",
      "textColor": "#004E7C",
      "borderRadius": 12,
      "paddingX": 8,
      "paddingY": 4
    },
    "alert": {
      "info": {
        "backgroundColor": "#E3F2FD",
        "borderColor": "#007ACC",
        "textColor": "#004E7C"
      },
      "success": {
        "backgroundColor": "#E8F5E9",
        "borderColor": "#4CAF50",
        "textColor": "#2E7D32"
      },
      "warning": {
        "backgroundColor": "#FFF3E0",
        "borderColor": "#FFC107",
        "textColor": "#E65100"
      },
      "error": {
        "backgroundColor": "#FFEBEE",
        "borderColor": "#F44336",
        "textColor": "#C62828"
      }
    }
  },

  "print": {
    "quality": "high",
    "colorMode": "color",
    "margin": "minimal",
    "paperSize": "A4"
  },

  "metadata": {
    "author": "Stimulsoft",
    "revision": "2.0",
    "compatibility": "2024.4+",
    "tags": ["corporate", "professional", "blue-theme"]
  }
}
